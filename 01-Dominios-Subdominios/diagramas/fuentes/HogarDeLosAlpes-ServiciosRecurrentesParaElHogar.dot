digraph DomainDetail {
  graph [
    rankdir=TB,
    bgcolor="#FFFFFF",
    pad=0.35,
    nodesep=0.45,
    ranksep=0.75,
    splines=ortho,
    fontname="Helvetica",
    label="Mapa estratégico de subdominios",
    labelloc=t,
    fontsize=22
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.24,0.18"];
  edge [arrowsize=0.65];

  domain [label="Servicios Recurrentes para el Hogar\n\nVisión: Ofrecer a los hogares servicios recurrentes\nconfiables mediante suscripciones flexibles que\naseguren continuidad, coordinación y calidad con\nproveedores acreditados.", fillcolor="#183B56", fontcolor="#FFFFFF", color="#183B56", penwidth=2.2, width=4.4];
  type_CORE_DOMAIN [label="NÚCLEO · 2 SUBDOMINIOS\n\n• Oferta de Suscripciones\n• Planificación de Servicios\nRecurrentes", fillcolor="#FFD5C9", color="#B94125", penwidth=2.0, width=4.1];
  type_SUPPORTING_DOMAIN [label="SOPORTE · 2 SUBDOMINIOS\n\n• Gestión del Ciclo de Suscripción\n• Facturación Recurrente", fillcolor="#D7E9FF", color="#2E6FA7", penwidth=2.0, width=4.1];
  { rank=same; type_CORE_DOMAIN; type_SUPPORTING_DOMAIN; }
  domain -> type_CORE_DOMAIN [color="#52616B", penwidth=1.8];
  domain -> type_SUPPORTING_DOMAIN [color="#52616B", penwidth=1.8];
}
